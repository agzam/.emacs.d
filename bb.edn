{:tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :as p]
             [clojure.edn :as edn]
             [clojure.string :as str])
  ;; *file* is cwd-relative under --config; the system property is not
  :init (do (def root (str (fs/parent (fs/canonicalize
                                       (or (System/getProperty "babashka.config")
                                           *file*)))))
            (def test-elpa (str (fs/path root ".local" ".cache" "test-elpa")))
            ;; Neither -Q nor --batch relocates `user-emacs-directory', and both
            ;; skip early-init.el and with it the eln redirect - so an
            ;; unadorned batch Emacs drops trampolines and package droppings
            ;; into whatever ~/.emacs.d the developer actually runs.
            (def emacs-batch
              ["emacs" "-Q" "--batch" "--init-directory" root
               ;; Guarded like early-init.el's copy: CI's Emacs has no native
               ;; comp, where the redirect dies on a void native-comp-eln-load-path.
               "--eval" (format "(when (and (featurep 'native-compile) (fboundp 'startup-redirect-eln-cache)) (startup-redirect-eln-cache %s))"
                                (pr-str (str (fs/path root ".local" ".cache" "eln"))))])

            (defn emacs-socket-owner
              "Pid of the process holding the default Emacs server socket, or nil.
Mirrors emacsclient's default socket path: $TMPDIR/emacs<uid>/server.
Consulted when a client connect is refused, because refusal is ambiguous:
a dead server refuses, but so does a live one whose listen backlog (5) is
full while its event loop is behind - only a live server still owns the
socket file."
              []
              (try
                (let [uid (str/trim (:out (p/shell {:out :string :err :string} "id" "-u")))
                      tmp (or (System/getenv "TMPDIR") "/tmp/")
                      sock (str tmp (when-not (str/ends-with? tmp "/") "/")
                                "emacs" uid "/server")
                      {:keys [exit out]} (p/shell {:continue true :out :string :err :string}
                                                  "lsof" "-t" (str sock))]
                  (when (zero? exit)
                    (first (remove str/blank? (str/split-lines out)))))
                (catch Exception _ nil)))
            (defn emacs-server-probe
              "Probe the Emacs server: :up, :busy (alive but not answering) or :down.
A ping that hangs is a busy-but-alive Emacs; a refused connect falls back
to `emacs-socket-owner` before it may conclude :down.  A missing
emacsclient binary reads as :down (the headless path needs no server)."
              []
              (try
                (let [proc (p/process {:out :string :err :string}
                                      "emacsclient" "--eval" "nil")
                      res (deref proc 3000 :hung)]
                  (cond (= res :hung) (do (p/destroy proc) :busy)
                        (zero? (:exit res)) :up
                        (emacs-socket-owner) :busy
                        :else :down))
                (catch Exception _ :down)))
            (defn emacs-alive?
              "Signal-0 liveness probe of PID, immune to how busy Emacs is.
Never a fresh client connect: a full socket backlog refuses exactly like
a dead server, which used to abandon healthy runs as died-mid-update."
              [pid]
              (zero? (:exit (p/shell {:continue true :out :string :err :string}
                                     "kill" "-0" (str pid)))))
            (defn follow-progress
              "Stream LOGFILE to stdout as it grows until an UPDATE- marker.
Return 0 on UPDATE-DONE, 2 when Emacs process PID vanishes mid-run (no
marker will ever come - the caller decides how to continue), 1 on any
other marker or once DEADLINE-MS elapses.  Liveness is `kill -0` on the
pid the kickoff round-trip returned, checked every ~2s; with PID nil the
death check is skipped and the deadline alone bounds the wait.  Tails
from a persistent offset instead of re-reading the whole file each tick;
the trailing partial line is carried over so a marker split across two
reads still matches its line anchor."
              [logfile deadline-ms pid]
              (let [deadline (+ (System/currentTimeMillis) deadline-ms)]
                (with-open [raf (java.io.RandomAccessFile. (str logfile) "r")]
                  (loop [carry "" last-ping (System/currentTimeMillis)]
                    (let [avail (- (.length raf) (.getFilePointer raf))
                          chunk (when (pos? avail)
                                  (let [buf (byte-array avail)]
                                    (.readFully raf buf)
                                    (String. buf java.nio.charset.StandardCharsets/UTF_8)))
                          seen (str carry chunk)
                          now (System/currentTimeMillis)
                          ping? (< 2000 (- now last-ping))]
                      (when chunk (print chunk) (flush))
                      (cond
                        (re-find (re-pattern "(?m)^UPDATE-DONE\\b") seen) 0
                        (re-find (re-pattern "(?m)^UPDATE-(FAILED|TIMEOUT|ERROR)\\b") seen) 1
                        (and ping? pid (not (emacs-alive? pid))) 2
                        (< deadline now)
                        (do (println "\nupdate: gave up waiting for Emacs to finish") 1)
                        :else (do (Thread/sleep 250)
                                  (recur (if-let [nl (str/last-index-of seen "\n")]
                                           (subs seen (inc nl))
                                           seen)
                                         (if ping? now last-ping)))))))))
            (defn tty-color?
              "True when ANSI color should be emitted: our stdout is a real
terminal (or ELPACA_UPDATE_COLOR=1 forces it) and NO_COLOR is unset."
              []
              (and (str/blank? (or (System/getenv "NO_COLOR") ""))
                   (or (some? (System/console))
                       (= "1" (System/getenv "ELPACA_UPDATE_COLOR")))))
            (defn run-batch-driver
              "Boot the full config in --batch, load scripts/DRIVER on top,
and return the exit code.  Shared by update/repair/audit - every headless
task is this one invocation with a different driver.  EXTRA-ENV merges
over the git-prompt guard (an unreachable remote must fail the order,
not block on a credential prompt)."
              [driver & [extra-env]]
              (:exit (p/shell {:continue true
                               :extra-env (merge {"GIT_TERMINAL_PROMPT" "0"} extra-env)}
                              "emacs" "-Q" "--batch"
                              "--init-directory" root
                              "-l" (str (fs/path root "early-init.el"))
                              "-l" (str (fs/path root "init.el"))
                              "-l" (str (fs/path root "scripts" driver))))))

  deps {:doc "Install test deps (buttercup, parseedn) into .local/.cache/test-elpa"
        :task (apply p/shell
                     (concat emacs-batch
                             ["--eval" (format "(setq package-user-dir %s)" (pr-str test-elpa))
                              "--eval" "(require 'package)"
                              "--eval" "(add-to-list 'package-archives '(\"melpa\" . \"https://melpa.org/packages/\"))"
                              "-f" "package-initialize"
                              "--eval" "(dolist (p '(buttercup parseedn)) (unless (package-installed-p p) (unless package-archive-contents (package-refresh-contents)) (package-install p)))"]))}

  lint {:doc "check-parens over every tracked .el file"
        :task (let [files (->> (p/shell {:out :string :dir root}
                                        "git" "ls-files" "-co" "--exclude-standard" "*.el")
                               :out
                               str/split-lines
                               (remove str/blank?)
                               ;; -c lists deleted-but-unstaged files too
                               (filter (fn [f] (fs/exists? (fs/path root f)))))]
                (apply p/shell {:dir root}
                       (concat emacs-batch ["-l" "scripts/lint.el"] files)))}

  test {:doc "Run the buttercup suites in tests/"
        :depends [deps]
        ;; :dir matters: buttercup-run-discover finds nothing from foreign cwds
        :task (apply p/shell {:dir root}
                     (concat emacs-batch
                             ["--eval" (format "(setq package-user-dir %s)" (pr-str test-elpa))
                              "-f" "package-initialize"
                              "--eval" "(setq buttercup-stack-frame-style 'omit)"
                              "-f" "buttercup-run-discover" (str (fs/path root "tests"))]))}

  smoke {:doc "Full Elpaca boot in a pty; verdict comes from the result marker"
         :task (let [result (str (fs/create-temp-file {:prefix "emacs-lab-smoke"}))
                     macos? (str/includes? (str/lower-case (System/getProperty "os.name")) "mac")
                     emacs-args ["emacs" "-nw" "--init-directory" root
                                 "-l" (str (fs/path root "scripts" "smoke-check.el"))]
                     ;; pty wrapper syntax differs: BSD vs util-linux script(1)
                     cmd (if macos?
                           (into ["script" "-q" "/dev/null"] emacs-args)
                           ["script" "-qec" (str/join " " emacs-args) "/dev/null"])]
                 (println "smoke: booting the config (first elpaca run can take minutes)...")
                 (apply p/shell {:continue true
                                 :extra-env {"SMOKE_RESULT_FILE" result
                                             ;; CI runners have no usable TERM
                                             "TERM" "xterm-256color"
                                             ;; a private/unreachable remote must fail the
                                             ;; elpaca order, not sit at a git prompt the
                                             ;; pty swallows until the watchdog
                                             "GIT_TERMINAL_PROMPT" "0"}}
                        cmd)
                 (let [verdict (if (fs/exists? result) (slurp result) "NO RESULT MARKER\n")]
                   (print verdict)
                   (flush)
                   (when-not (str/starts-with? verdict "SMOKE-OK")
                     (System/exit 1))))}

  update {:doc "Update every Elpaca package: drives the running Emacs live (streamed, no restart) if its server is up, else headless --batch (restart after). Like `doom sync -u'. Re-run while one is in flight re-attaches to its progress."
          :task (let [probe (emacs-server-probe)]
                  (if (not= :down probe)
                    ;; Server up (or busy): run the update INSIDE the live Emacs
                    ;; so it picks up changes without a restart.  emacsclient
                    ;; kicks it off async and returns (emacs-pid PROGRESS-FILE)
                    ;; in one round-trip; we then tail the progress file.  An
                    ;; update already in flight hands back its own file instead
                    ;; of starting a second one - tailing that from the top
                    ;; replays its progress so far.
                    (let [logfile (str (fs/create-temp-file {:prefix "emacs-lab-update"}))
                          driver (str (fs/path root "scripts" "elpaca-live-update.el"))
                          _ (println "update: driving the running Emacs (live, no restart needed)...")
                          _ (when (= :busy probe)
                              (println "update: the Emacs server is busy; waiting for it to take the kickoff..."))
                          {:keys [exit out err]}
                          (p/shell {:continue true :out :string :err :string}
                                   "emacsclient" "--eval"
                                   (format "(progn (load %s) (list (emacs-pid) (elpaca-live-update-start %s nil %s)))"
                                           (pr-str driver) (pr-str logfile)
                                           (if (tty-color?) "t" "nil")))]
                      (if (zero? exit)
                        (let [[pid in-use] (try (edn/read-string (str/trim (str out)))
                                                (catch Exception _ nil))
                              attached? (and (string? in-use) (not= in-use logfile))
                              logfile (if (string? in-use) in-use logfile)]
                          (when attached?
                            (println "update: an update is already in flight; attaching to its progress..."))
                          (let [code (follow-progress logfile (* 40 60 1000) pid)]
                            (when (= 2 code)
                              ;; No auto-continuation on purpose: a killed Emacs
                              ;; may mean "stop everything".  A re-run picks the
                              ;; path by probe; the heal phase (dirty/stale/
                              ;; half-built scans) completes interrupted work.
                              (println (format "\nupdate: the live Emacs (pid %s) died mid-update; run `bb update' again to finish" pid)))
                            (System/exit (if (zero? code) 0 1))))
                        (do (println "update: could not start in-session update:" (str/trim (str err)))
                            (System/exit 1))))
                    ;; Server down (e.g. CI): plain --batch, no pty, pipeable.
                    ;; --batch does not auto-load user init, so early-init + init
                    ;; are loaded explicitly before the driver.
                    (do
                      (println "update: no Emacs server; updating headlessly in --batch (restart Emacs after to apply)...")
                      (System/exit (run-batch-driver "elpaca-update.el"
                                                     (when (tty-color?)
                                                       {"ELPACA_UPDATE_COLOR" "1"}))))))}

  repair {:doc "Heal botched packages, doom-sync style: fresh headless boot (re-clones deleted repos, rebuilds deleted builds), then rebuild anything half-built, stale or dirty. Restart Emacs after."
          :task (System/exit (run-batch-driver "elpaca-repair.el"))}

  audit {:doc "Void-command audit: boot the full config in --batch, then flag transient suffixes and leader bindings whose commands are neither defined nor autoloaded"
         :task (System/exit (run-batch-driver "audit-void-commands.el"))}

  docsets {:doc "Install/update the Dash docsets the config expects (batch, like doom.d's `make dash-docsets')"
           :task (apply p/shell
                        (concat emacs-batch
                                ["-l" (str (fs/path root "scripts" "install-docsets.el"))]))}

  check-root {:doc "Fail on anything at the config root that is neither tracked nor a sanctioned exception - a stray means some run wrote outside .local/"
              :task (System/exit
                     (:exit (apply p/shell {:continue true}
                                   (concat emacs-batch
                                           ["-l" (str (fs/path root "scripts" "check-root.el"))
                                            "--eval" (format "(check-root-main %s)" (pr-str root))]))))}

  ci {:doc "deps + lint + test + check-root (the fast tier; smoke is a separate job)"
      :depends [deps lint test check-root]}}}
